# --- Database (Supabase) ---------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the *Session pooler* URI (IPv4-compatible; works from Render's free tier).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Leave unset locally to use an embedded in-memory Postgres (PGlite) instead.
# USE_PGLITE=1

# --- API ---------------------------------------------------------------------
PORT=8080
# Comma-separated list of allowed browser origins (your Vercel URL). "*" allows all.
CORS_ORIGIN=http://localhost:5173
# Shared secret cron-job.org sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me-to-a-long-random-string

# --- Store -------------------------------------------------------------------
STORE_BASE_URL=https://demo.inelabteamdev.com

# --- Scraper tuning (all optional) ------------------------------------------
# Attempts per product per run before it is recorded as failed.
SCRAPE_MAX_ATTEMPTS=6
# Products scraped concurrently within one run (keep 1 on Render free / 512 MB).
SCRAPE_CONCURRENCY=1
# A product is "due" once this many minutes have passed (minus a small grace window).
DEFAULT_INTERVAL_MINUTES=120
# Unset = headed when a display exists (Windows/macOS/Xvfb), else headless. 1 = force headed, 0 = force headless.
# SCRAPE_HEADED=1

# --- Local browser -------------------------------------------------------------
# Drive your installed Chrome instead of Playwright's bundled Chromium (no ~200 MB download).
# BROWSER_CHANNEL=chrome
